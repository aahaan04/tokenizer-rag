# LLM provider used for generation and query rewriting.
# "groq" (default, free tier) or "gemini".
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: increases Semantic Scholar's unauthenticated rate limit if set.
# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=
