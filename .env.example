# LLM provider used for generation and query rewriting.
# "groq" (default, free tier) or "gemini".
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.3-70b-versatile was removed from Groq's free tier (Enterprise-only
# since 2026-08-16). Current free-tier production models (verified 2026-10-07,
# 1,000 RPM / 250,000 TPM each): openai/gpt-oss-120b, openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-120b
# Smaller/faster model used for query rewriting and the groundedness judge —
# both simpler tasks than answer generation, so a lighter model keeps latency
# and free-tier budget down.
GROQ_FAST_MODEL=openai/gpt-oss-20b

# https://aistudio.google.com/apikey (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional but recommended: Semantic Scholar's unauthenticated tier is a shared
# global pool and gets 429'd easily. A free key gives a dedicated rate limit.
# https://www.semanticscholar.org/product/api#api-key
# (S2_API_KEY also works, if that's what your key dashboard calls it)
SEMANTIC_SCHOLAR_API_KEY=
